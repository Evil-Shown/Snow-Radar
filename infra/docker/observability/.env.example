# Snow Radar Observability Stack - Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# docker compose will refuse to start Grafana without GRAFANA_ADMIN_PASSWORD.

# Grafana (REQUIRED, no default)
GRAFANA_ADMIN_PASSWORD=

# Grafana public URL if fronted by a reverse proxy
GF_SERVER_ROOT_URL=http://localhost:3000

# Alertmanager (optional — email/Discord alerts; substituted at container start)
SMTP_PASSWORD=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
