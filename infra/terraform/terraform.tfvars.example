# SECURITY (ADR-005): do NOT put real credentials in tfvars files.
# Supply secrets via environment variables instead:
#   export TF_VAR_hcloud_token="..."
#   export TF_VAR_oci_tenancy_ocid="ocid1.tenancy.oc1..aaaa..."
#   export TF_VAR_oci_user_ocid="ocid1.user.oc1..aaaa..."
#   export TF_VAR_oci_fingerprint="xx:xx:..."
#   export TF_VAR_oci_compartment_id="ocid1.compartment.oc1..aaaa..."
#
# Only NON-secret values belong here:

oci_region              = "ap-singapore-1"
oci_availability_domain = ""

ssh_public_key = "ssh-ed25519 AAAA... your-key"
