# =============================================================================
# Snow Radar — Canonical network allocation (SINGLE SOURCE OF TRUTH)
# See docs/adr/004-unified-subnet-scheme.md
# Sourced by every phase-1 setup script. Do NOT hardcode these values elsewhere.
# =============================================================================

# Protocol ports (identical on every exit node)
WG_PORT=51820
AWG_PORT=51821

# Interface names
WG_IFACE_NAME="wg0"
AWG_IFACE_NAME="awg0"

# --- Singapore (Oracle ARM) — node block 10.20.0.0/16 ---
SGP_WG_SUBNET_V4="10.20.0.0/24"
SGP_WG_SERVER_V4="10.20.0.1"
SGP_WG_SUBNET_V6="fd00:20::/64"
SGP_WG_SERVER_V6="fd00:20::1"
SGP_AWG_SUBNET_V4="10.20.1.0/24"
SGP_AWG_SERVER_V4="10.20.1.1"
SGP_AWG_SUBNET_V6="fd00:20:1::/64"
SGP_AWG_SERVER_V6="fd00:20:1::1"

# --- Falkenstein DE (Hetzner) — node block 10.21.0.0/16 ---
FSN_WG_SUBNET_V4="10.21.0.0/24"
FSN_WG_SERVER_V4="10.21.0.1"
FSN_WG_SUBNET_V6="fd00:21::/64"
FSN_WG_SERVER_V6="fd00:21::1"
FSN_AWG_SUBNET_V4="10.21.1.0/24"
FSN_AWG_SERVER_V4="10.21.1.1"
FSN_AWG_SUBNET_V6="fd00:21:1::/64"
FSN_AWG_SERVER_V6="fd00:21:1::1"
